# OpenAI — required for campaign generation (strategy, content, DALL·E-class images, compliance, video scripts).
# Without a valid key, POST /generate-campaign returns 503. No placeholder media.
OPENAI_API_KEY=your_key_here
# Optional image model (default dall-e-3). Must return an https URL for posts.
# OPENAI_IMAGE_MODEL=dall-e-3

# Max non-failed campaigns per user for the free plan (default 9999 for local dev). Use 2 for production SaaS.
# BROKERAI_FREE_CAMPAIGN_LIMIT=9999
# Optional: pro / agency caps (defaults 15 / 9999).
# BROKERAI_PRO_CAMPAIGN_LIMIT=15
# BROKERAI_AGENCY_CAMPAIGN_LIMIT=9999

# Ayrshare — Primary Profile API key (Dashboard → Social Media API → API Key). Never use a User
# Profile Key here (that value is only for the Profile-Key header). Never commit real values.
# Used for: POST /api/profiles (create user profile), POST /api/profiles/generateJWT (SSO link URL),
# POST /api/post + Profile-Key (publish to each end-user’s linked networks).
# Example Business onboarding export: integration-aayrshare/postman-generateJWT-example.json (domain + privateKey).
AYRSHARE_API_KEY=

# Primary Ayrshare account only: POST /api/post without Profile-Key (local testing; not for Business multi-profile).
# AYRSHARE_SINGLE_ACCOUNT_PUBLISH=true

# Business Plan — JWT SSO (Integration Guide / Generate JWT)
# "Domain" is the exact app id from onboarding (e.g. id-xxxxxx), NOT your website hostname.
AYRSHARE_SSO_DOMAIN=

# Private key from your Ayrshare onboarding package (PKCS#8 PEM: -----BEGIN PRIVATE KEY----- …)
#
# ── RECOMMENDED for Render/cloud ──────────────────────────────────────────────────────────────
# Option A — Base64 value (safest, no multiline paste issues in cloud dashboards):
#   macOS/Linux: base64 -i id-YF7L--private-key.pem | tr -d '\n'
#   Then paste the single-line output as AYRSHARE_PRIVATE_KEY_BASE64_VALUE below.
AYRSHARE_PRIVATE_KEY_BASE64_VALUE=
#
# ── LOCAL DEV alternatives ────────────────────────────────────────────────────────────────────
# Option B — path to the PEM file (keep file outside git; ignored in .gitignore):
AYRSHARE_PRIVATE_KEY_PATH=
# Option C — inline PEM with literal \n line separators:
# AYRSHARE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
AYRSHARE_PRIVATE_KEY=

# How many of facebook + instagram + linkedin must be OAuth-linked for “fully connected” checks (1–3). Default 1.
# AYRSHARE_MIN_LINKED_PLATFORMS=1
# After OAuth, GET /api/user can be briefly empty — polling before showing “not connected”:
# AYRSHARE_OAUTH_VERIFY_ATTEMPTS=5
# AYRSHARE_OAUTH_VERIFY_DELAY_SEC=0.85

# generateJWT body: json (default, per Ayrshare docs) or form (Postman-style x-www-form-urlencoded).
# AYRSHARE_GENERATE_JWT_MODE=json
# If using form mode, set to true to send allowedSocial[] for facebook/instagram/linkedin only.
# AYRSHARE_JWT_FORM_INCLUDE_ALLOWED_SOCIAL=false

# Public HTTPS origin of this app (no trailing slash). JWT "redirect" after user taps Done on Ayrshare.
# Example: https://yourapp.onrender.com
BROKERAI_PUBLIC_ORIGIN=

# Background job: re-sync social_accounts from Ayrshare GET /user every 5 minutes (set to 1 to disable).
# BROKERAI_DISABLE_SOCIAL_BACKGROUND_SYNC=1

# Optional HMAC secret for POST /api/webhooks/ayrshare (social sync). If unset, signature is not required.
# If unset and you use publish webhooks too, you may set AYRSHARE_PUBLISH_WEBHOOK_SECRET — the social webhook
# will accept the same header for convenience.
# AYRSHARE_SOCIAL_WEBHOOK_SECRET=

# JWT signing secret — required for /api/auth (≥32 random characters in production)
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Optional: trial length (days) for new signups — sets plan_status=trial and plan_expires_at
# BROKERAI_TRIAL_DAYS=0

# Optional: base URL for password-reset emails (defaults to BROKERAI_PUBLIC_ORIGIN / APP_URL)
# PUBLIC_APP_URL=https://yourapp.onrender.com

# Google OAuth2 — S4-05: "Continue with Google" login/signup
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly (include /auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourapp.com/auth/google/callback

# HTTP port (Docker / Render / `python -m backend.main`). Local uvicorn can pass --port instead.
# PORT=8000

# Optional: SQLite path (default: ./brokerai.db in project root)
# DATABASE_URL=sqlite:///./brokerai.db

# Optional: Redis connection URL for campaign list + analytics summary caching (5-minute TTL).
# App works fully without Redis — omit or leave blank to disable caching.
# Example: redis://localhost:6379/0  or  rediss://:<password>@host:6380/0
REDIS_URL=                     # Optional: Redis connection URL

# Log level: DEBUG, INFO (default), WARNING, ERROR, CRITICAL
# Set to DEBUG while troubleshooting Ayrshare connection or wizard gate issues.
# LOG_LEVEL=INFO

# Sentry error tracking — optional. Leave blank to disable.
SENTRY_DSN=                    # Optional: your Sentry DSN for error tracking
SENTRY_TRACES_RATE=0.1         # Sentry performance traces sample rate (0.0-1.0)
ENVIRONMENT=production         # App environment (development/staging/production)
APP_VERSION=1.0.0              # App version tag shown in /health

# Tests: set to 1 to skip the background publish scheduler (pytest sets this automatically).
# BROKERAI_DISABLE_SCHEDULER=1

# CORS: comma-separated list of allowed origins (default: * for dev)
# In production, set to your actual domain(s):
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# LangGraph checkpoint DB (default: ./brokerai_checkpoints.db)
# CHECKPOINT_DB_URL=sqlite:///./brokerai_checkpoints.db

# Unsplash — Smart Image Selector in the New Campaign Wizard.
# Create a free app at https://unsplash.com/oauth/applications.
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# AI Video — wizard "Generate video preview".
# Default is OpenAI Sora (same OPENAI_API_KEY as the rest of the app).
# Optional: OPENAI_SORA_MODEL=sora-2 (default) or sora-2-pro
# OPENAI_SORA_MODEL=sora-2
#
# To use Replicate instead: BROKERAI_VIDEO_BACKEND=replicate and set REPLICATE_API_TOKEN.
# BROKERAI_VIDEO_BACKEND=openai
#
# Replicate (only if BROKERAI_VIDEO_BACKEND=replicate)
# Sign up at https://replicate.com and create an API token.
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=luma/ray-flash-2-540p

# Wizard "Choose your visuals" (step 2) — OpenAI suggests names + Unsplash queries; Unsplash loads photos.
# MANUS_VISUAL_TEMPLATE_COUNT=8
# OPENAI_WIZARD_TEMPLATE_MODEL=gpt-4o-mini
# Parallel Unsplash searches while filling the template grid (1–6).
# MANUS_VISUAL_TEMPLATE_UNSPLASH_CONCURRENCY=3

# Comma-separated emails that skip the monthly *campaign creation* cap (internal QA only).
# Example: BROKERAI_UNLIMITED_CAMPAIGNS_EMAILS=ops@mycompany.com
# BROKERAI_UNLIMITED_CAMPAIGNS_EMAILS=

# ── Stripe (required for signup → Checkout and /billing/checkout) ──────────
# Secret key: Dashboard → Developers → API keys (use sk_test_… locally).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) when POST /stripe/webhook is configured — optional for Checkout redirect alone.
STRIPE_WEBHOOK_SECRET=
# Public site URL, no trailing slash — success/cancel URLs for Checkout (local: http://127.0.0.1:8000).
APP_URL=http://127.0.0.1:8000
# One Stripe Price id per plan (Dashboard → Product catalog → product → recurring monthly price → copy price_…).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# Demo accounts (password BrokerAI-Demo!1): python scripts/seed_demo_accounts.py
