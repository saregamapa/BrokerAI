# OpenAI — required for campaign generation (strategy, content, DALL·E-class images, compliance, video scripts).
# Without a valid key, POST /generate-campaign returns 503. No placeholder media.
OPENAI_API_KEY=your_key_here
# Optional image model (default dall-e-3). Must return an https URL for posts.
# OPENAI_IMAGE_MODEL=dall-e-3

# Ayrshare — get key from https://www.ayrshare.com/ (Dashboard → API Key)
# Used to create user profiles, SSO linking, and publish approved posts (Profile-Key header).
AYRSHARE_API_KEY=

# Business Plan — JWT SSO for https://profile.ayrshare.com linking page (see Generate JWT docs)
# Domain string from your Ayrshare integration package (not a URL hostname).
AYRSHARE_SSO_DOMAIN=
# RSA private key PEM (use \n for newlines in .env) OR path to a .pem file:
# AYRSHARE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
AYRSHARE_PRIVATE_KEY=
# AYRSHARE_PRIVATE_KEY_PATH=/path/to/private.key

# Public HTTPS origin of this app (no trailing slash). Used as Ayrshare JWT redirect after linking.
# Example: https://yourapp.onrender.com
BROKERAI_PUBLIC_ORIGIN=

# JWT signing secret — set a long random string in production
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# HTTP port (Docker / Render / `python -m backend.main`). Local uvicorn can pass --port instead.
# PORT=8000

# Optional: SQLite path (default: ./brokerai.db in project root)
# DATABASE_URL=sqlite:///./brokerai.db

# Tests: set to 1 to skip the background publish scheduler (pytest sets this automatically).
# BROKERAI_DISABLE_SCHEDULER=1

# CORS: comma-separated list of allowed origins (default: * for dev)
# In production, set to your actual domain(s):
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# LangGraph checkpoint DB (default: ./brokerai_checkpoints.db)
# CHECKPOINT_DB_URL=sqlite:///./brokerai_checkpoints.db
